    "message": "topic.encode(\"utf-8\") + b\"\\n\" + canonical",
    "sig": "hmac.new(secret.encode(\"utf-8\"), message, hashlib.sha256).hexdigest()",
    "compare": "constant-time comparison of the lower-case hex strings"
  },
