# Copy this file to tools/.env (ignored by git) and fill in your own values.
# Every value here is a placeholder. docker compose reads tools/.env for the services in
# tools/compose.yaml; the node reads the two ROS2_HA_BRIDGE_* secrets from the environment
# when the matching parameter (mqtt.password, command.secret) is left empty.

# Broker reachable from the containers. With the local-broker profile use: local-broker
MQTT_HOST=broker.example.invalid
MQTT_PORT=1883
# Leave MQTT_USERNAME empty for an anonymous broker (the local-broker profile).
MQTT_USERNAME=changeme
ROS2_HA_BRIDGE_MQTT_PASSWORD=changeme
# Empty means HMAC off (the default). Set the same value in the HA integration to switch it on.
ROS2_HA_BRIDGE_COMMAND_SECRET=
# DDS domain inside the containers; it never leaves the compose network.
ROS_DOMAIN_ID=42
# MQTT topic prefix; must match the Home Assistant integration's prefix.
TOPIC_PREFIX=ros2_bridge

# A parameters file to start from, as a path INSIDE the container; mount it with the commented
# volumes block in compose.yaml or with -v on docker compose run. Empty means none: the node's
# defaults plus the overrides above.
ROS2_HA_BRIDGE_PARAMS_FILE=

# Any other node parameter is set per container with ROS2_HA_BRIDGE_PARAM_<NAME>, where <NAME>
# is the dotted name in upper case with dots as double underscores (tools/README.md, What the
# entrypoint reads). compose only hands a variable to a container when it is listed under that
# service's "environment:", so put such variables under the service in compose.yaml (the
# commented example there) or pass them with -e on docker compose run; a line in this file
# alone is not seen by the node. Example (uncomment and move under a service):
# ROS2_HA_BRIDGE_PARAM_WATCHDOG__MODE=inhibit_new

# DDS isolation of the rig (tools/README.md, Networking). The defaults keep discovery inside
# each container; change them only if you know what you are doing.
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
